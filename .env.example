# PostgreSQL Database Connection (DBMS Course Project)
# Replace with your local PostgreSQL credentials or Supabase/Neon connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fresh_farm"

# Explicit connection parameters (alternative to DATABASE_URL)
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="fresh_farm"
PGUSER="postgres"
PGPASSWORD="your_password_here"
