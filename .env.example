# Local PostgreSQL defaults. Keep your real values in .env.local (never GitHub).
PGHOST=localhost
PGPORT=5432
PGDATABASE=fresh_farm
PGUSER=postgres
PGPASSWORD=replace_me
SESSION_SECRET=replace_with_at_least_32_random_characters

# For hosting, prefer DATABASE_URL (and leave out PGHOST/PGPASSWORD):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional secure product-file uploads via Cloudinary (HTTPS links work without these):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
